{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Observed events",
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(observatory_events_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Successful operations",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(observatory_events_by_context_total{event_type=~\"model.operation|tool.operation\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"success|succeeded|ok\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Failed operations",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(observatory_events_by_context_total{event_type=~\"model.operation|tool.operation\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"failed|failure|error|rejected|timeout|aborted\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Conflicting replays (global)",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "observatory_event_conflicts_total or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "timeseries",
      "title": "Observed operations by provider and model",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(20, observatory_events_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"})", "legendFormat": "{{event_type}} / {{project}} / {{repository}} / {{branch}} / {{provider}} / {{model}} / {{model_variant}} / {{client}} / {{agent}} / {{parent_agent}} / {{subagent}} / {{skill}} / {{workflow}} / {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "links": [{"title": "Open model comparison", "url": "/d/model-comparison/model-comparison?orgId=1&var-project=${__field.labels.project}&var-provider=${__field.labels.provider}&var-model=${__field.labels.model}&var-model_variant=${__field.labels.model_variant}", "type": "link", "targetBlank": false}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "Usage evidence classes",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (usage_source) (observatory_events_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"})", "legendFormat": "{{usage_source}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "logs",
      "title": "Telemetry diagnostics",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=\"otel-collector\"}", "refId": "A"}],
      "options": {"showTime": true, "showUniqueLabels": false, "wrapLines": false, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending"}
    },
    {
      "type": "stat",
      "title": "Normalizer ready (global)",
      "id": 9,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "system-prometheus"},
      "targets": [{"expr": "observatory_process_ready", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Rejected intake records (global)",
      "id": 10,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 20},
      "datasource": {"type": "prometheus", "uid": "system-prometheus"},
      "targets": [{"expr": "observatory_ingest_rejected_total", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Normalizer uptime (global)",
      "id": 11,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "system-prometheus"},
      "targets": [{"expr": "observatory_process_uptime_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "text",
      "title": "Evidence boundary",
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {"mode": "markdown", "content": "**ALL PROJECTS** is the default scope. Counts describe observed and correlated telemetry; they do not prove that a model caused an outcome.\n\nToken and cost comparisons are only comparable when their provenance and billing semantics match. `provider`, `client`, `gateway`, `estimated`, and `derived` evidence remain distinct in the normalized store. Observatory Events values are event-time scoped; use API `start`/`end` filters for complete time-bounded analysis."}
    }
  ],
  "schemaVersion": 39,
  "tags": ["llm", "observability", "metadata-first"],
  "templating": {
