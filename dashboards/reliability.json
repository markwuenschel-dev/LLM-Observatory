  "panels": [
    {"type": "stat", "id": 1, "title": "Failed operations", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_events_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"failed|failure|error|rejected|timeout|aborted\"}) or vector(0)", "refId": "A"}]},
    {"type": "stat", "id": 2, "title": "Retry attempts", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_retries_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "refId": "A"}]},
    {"type": "stat", "id": 3, "title": "Rate-limited operations", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_rate_limited_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "refId": "A"}]},
    {"type": "stat", "id": 4, "title": "Timeout operations", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_timeouts_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "refId": "A"}]},
    {"type": "timeseries", "id": 5, "title": "Outcome status distribution", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "observatory_outcomes_by_kind_status_total{kind=~\"$outcome_kind\",status=~\"$outcome_status\",evidence_source=~\"$evidence_source\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\"}", "legendFormat": "{{kind}} / {{status}} / {{project}}", "refId": "A"}]},
    {"type": "timeseries", "id": 6, "title": "Provider/model operational volume", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(30, observatory_events_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"})", "legendFormat": "{{project}} / {{repository}} / {{branch}} / {{provider}} / {{model}} / {{client}} / {{usage_source}}", "refId": "A"}]},
    {"type": "text", "id": 7, "title": "Reliability boundary", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 18}, "options": {"mode": "markdown", "content": "Failure, retry, timeout, rate-limit, tool-failure, agent-failure, reassessment/rework, and outcome evidence are retained separately. A telemetry failure is not an inference failure; check `inference_path` and Observatory health independently. Observatory Events values are event-time scoped; use API `start`/`end` filters for complete time-bounded analysis."}},
    {"type": "timeseries", "id": 12, "title": "Agent failure and rework loops", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_agent_failures_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "legendFormat": "agent failures", "refId": "A"}, {"expr": "sum(observatory_reassessments_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "legendFormat": "reassessments", "refId": "B"}, {"expr": "sum(observatory_rework_loops_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",provider=~\"$provider\",model=~\"$model\",model_family=~\"$model_family\",model_variant=~\"$model_variant\",client=~\"$client\",auth_mode=~\"$auth_mode\",route=~\"$route\",usage_source=~\"$usage_source\",agent=~\"$agent\",subagent=~\"$subagent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\",workflow=~\"$workflow\",task_class=~\"$task_class\",status=~\"$status\"}) or vector(0)", "legendFormat": "rework loops", "refId": "C"}]},
    {"type": "timeseries", "id": 8, "title": "Collector exporter queue", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "system-prometheus"}, "targets": [{"expr": "max by (exporter) (otelcol_exporter_queue_size)", "legendFormat": "{{exporter}} queued", "refId": "A"}, {"expr": "max by (exporter) (otelcol_exporter_queue_capacity)", "legendFormat": "{{exporter}} capacity", "refId": "B"}]},
    {"type": "timeseries", "id": 9, "title": "Collector exporter enqueue failures", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "system-prometheus"}, "targets": [{"expr": "sum(otelcol_exporter_enqueue_failed_spans) or vector(0)", "legendFormat": "failed spans", "refId": "A"}, {"expr": "sum(otelcol_exporter_enqueue_failed_metric_points) or vector(0)", "legendFormat": "failed metric points", "refId": "B"}, {"expr": "sum(otelcol_exporter_enqueue_failed_log_records) or vector(0)", "legendFormat": "failed log records", "refId": "C"}]},
    {"type": "timeseries", "id": 10, "title": "Collector exporter send failures", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}, "datasource": {"type": "prometheus", "uid": "system-prometheus"}, "targets": [{"expr": "sum(otelcol_exporter_send_failed_spans) or vector(0)", "legendFormat": "failed spans", "refId": "A"}, {"expr": "sum(otelcol_exporter_send_failed_metric_points) or vector(0)", "legendFormat": "failed metric points", "refId": "B"}, {"expr": "sum(otelcol_exporter_send_failed_log_records) or vector(0)", "legendFormat": "failed log records", "refId": "C"}]},
    {"type": "text", "id": 11, "title": "Collector self-observability", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 40}, "options": {"mode": "markdown", "content": "These panels use the Collector's internal Prometheus endpoint on port 8888. Queue size, enqueue failures, and send failures describe telemetry-plane degradation and do not establish an inference failure. A missing sample means the Collector self-metrics endpoint or series is unavailable; verify `doctor`, `/readyz`, and Collector logs."}}
