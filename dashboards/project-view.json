{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {"type": "stat", "id": 1, "title": "Project event volume", "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(observatory_events_by_project_total{project=~\"$project\"})", "refId": "A"}]},
    {"type": "stat", "id": 2, "title": "Projects in scope", "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "count(observatory_events_by_project_total{project=~\"$project\"})", "refId": "A"}]},
    {"type": "stat", "id": 3, "title": "Conflicting replays (global)", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "observatory_event_conflicts_total or vector(0)", "refId": "A"}]},
    {"type": "timeseries", "id": 4, "title": "Project volume by client route", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(20, observatory_events_by_client_route_total{project=~\"$project\"})", "legendFormat": "{{project}} / {{client}} / {{route}} / {{auth_mode}}", "refId": "A"}]},
    {"type": "logs", "id": 5, "title": "Collector diagnostics", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{service_name=\"otel-collector\"}", "refId": "A"}], "options": {"showTime": true, "sortOrder": "Descending"}},
    {"type": "text", "id": 6, "title": "Attribution boundary", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12}, "options": {"mode": "markdown", "content": "Project identity is resolved externally from Git root, sanitized remote, branch, commit, and worktree. An event associated with a project is not evidence that the project caused the model outcome. Observatory Events values are event-time scoped; use the API start/end filters for complete time-bounded analysis."}}
  ],
  "schemaVersion": 39,
  "templating": {"list": [{"name": "project", "label": "Project", "type": "query", "query": "label_values(observatory_events_by_project_total, project)", "includeAll": true, "allValue": ".*", "current": {"text": "ALL PROJECTS", "value": "$__all"}}]},
  "time": {"from": "now-24h", "to": "now"},
  "title": "Project View",
