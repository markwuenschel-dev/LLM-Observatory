    {"type": "timeseries", "id": 1, "title": "Agent hierarchy volume", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(50, observatory_events_by_agent_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\"})", "legendFormat": "{{project}} / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "A"}]},
    {"type": "timeseries", "id": 2, "title": "Agent behavior", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [
      {"expr": "sum by (parent_agent,agent,subagent) (observatory_tool_calls_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\"})", "legendFormat": "tool calls / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "A"},
      {"expr": "sum by (parent_agent,agent,subagent) (observatory_files_changed_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\"})", "legendFormat": "files changed / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "B"},
      {"expr": "sum by (parent_agent,agent,subagent) (observatory_commands_executed_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\"})", "legendFormat": "commands / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "C"},
      {"expr": "sum by (parent_agent,agent,subagent) (observatory_tests_invoked_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\"})", "legendFormat": "tests / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "D"}
