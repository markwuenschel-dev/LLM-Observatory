    {"type": "timeseries", "id": 1, "title": "Execution role/skill/lane volume", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(50, observatory_events_by_execution_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\"})", "legendFormat": "{{project}} / {{role}} / {{skill}} / {{lane}}", "refId": "A"}]},
    {"type": "timeseries", "id": 2, "title": "Client route/auth volume", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(50, observatory_events_by_client_route_total{project=~\"$project\",client=~\"$client\",route=~\"$route\",auth_mode=~\"$auth_mode\"})", "legendFormat": "{{project}} / {{client}} / {{route}} / {{auth_mode}}", "refId": "A"}]},
    {"type": "traces", "id": 3, "title": "Trace explorer", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}, "datasource": {"type": "tempo", "uid": "tempo"}, "targets": [{"queryType": "traceql", "query": "{}", "refId": "A"}]},
    {"type": "timeseries", "id": 5, "title": "Agent behavior counts", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [
      {"expr": "observatory_tool_calls_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\"}", "legendFormat": "tool calls / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "A"},
      {"expr": "observatory_files_changed_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\"}", "legendFormat": "files changed / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "B"},
      {"expr": "observatory_commands_executed_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\"}", "legendFormat": "commands / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "C"},
      {"expr": "observatory_tests_invoked_by_context_total{event_type=~\"$event_type\",project=~\"$project\",repository=~\"$repository\",branch=~\"$branch\",agent=~\"$agent\",subagent=~\"$subagent\",parent_agent=~\"$parent_agent\",role=~\"$role\",skill=~\"$skill\",lane=~\"$lane\"}", "legendFormat": "tests / {{parent_agent}} / {{agent}} / {{subagent}}", "refId": "D"}
    ]},
    {"type": "text", "id": 4, "title": "Hierarchy boundary", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 26}, "options": {"mode": "markdown", "content": "Agent behavior is metadata-only: bounded counts and tool names are retained, while raw paths, commands, arguments, results, and test payloads are excluded by default. Session, workflow, agent, subagent, parent, and tool relationships are retained when the source supplies them. Missing hierarchy is represented as unknown rather than fabricated. High-cardinality IDs belong in the event detail/attribution API and Tempo, not Prometheus labels. Observatory Events values are event-time scoped; use API `start`/`end` filters for complete time-bounded analysis."}}
  ],
  "schemaVersion": 39,
